<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.punishers.autopush</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/matthewohrn/Projects/punishers-dashboard/autopush.sh</string>
	</array>

	<!-- Fires whenever data.json or index.html is modified -->
	<key>WatchPaths</key>
	<array>
		<string>/Users/matthewohrn/Projects/punishers-dashboard/data.json</string>
		<string>/Users/matthewohrn/Projects/punishers-dashboard/index.html</string>
	</array>

	<!-- Don't fire more than once every 30s -->
	<key>ThrottleInterval</key>
	<integer>30</integer>

	<key>StandardOutPath</key>
	<string>/Users/matthewohrn/Projects/punishers-dashboard/autopush.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/matthewohrn/Projects/punishers-dashboard/autopush.log</string>
</dict>
</plist>
